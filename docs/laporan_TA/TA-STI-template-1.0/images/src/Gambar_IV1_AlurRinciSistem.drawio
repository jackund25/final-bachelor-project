<mxfile host="app.diagrams.net" version="24.7.7">
  <diagram name="Alur Rinci Sistem" id="alur-1">
    <mxGraphModel dx="1500" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="t" value="Alur Rinci Sistem RAG Terkondisi-Prediksi" style="text;html=1;fontSize=18;fontStyle=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="400" y="20" width="600" height="30" as="geometry" />
        </mxCell>

        <mxCell id="b1" value="1. MASUKAN LOGBOOK&#10;&#10;glukosa · karbohidrat · insulin&#10;aktivitas · stres&#10;&#10;dimasukkan dokter saat konsultasi" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="60" y="80" width="260" height="130" as="geometry" />
        </mxCell>

        <mxCell id="b2" value="2. REKAYASA FITUR&#10;&#10;IOB  (τ = 240 mnt)&#10;COB  (τ = 180 mnt)&#10;tren 3 langkah · jam sin/cos&#10;&#10;27,8 ms" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="60" y="250" width="260" height="150" as="geometry" />
        </mxCell>

        <mxCell id="b3" value="3. PRAKIRAAN&#10;&#10;Gradient Boosting&#10;horizon +30 / +60 menit&#10;&#10;interval dari lebar antar-kuantil,&#10;dikalibrasi konformal&#10;&#10;9,2 ms" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="400" y="80" width="270" height="180" as="geometry" />
        </mxCell>

        <mxCell id="b4" value="4. KONDISI KLINIS TERSTRUKTUR&#10;&#10;diturunkan dari nilai TERPREDIKSI:&#10;• tingkat risiko&#10;• arah dan laju perubahan&#10;• tingkat kegentingan&#10;&#10;peringatan divergensi bila kondisi&#10;kini aman tetapi prediksi tidak" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="400" y="300" width="270" height="190" as="geometry" />
        </mxCell>

        <mxCell id="b5" value="5. KUERI TERKONDISI-PREDIKSI&#10;&#10;kueri disusun dari kondisi MASA DEPAN,&#10;bukan dari kondisi yang sedang berlaku&#10;&#10;← inilah kebaruan penelitian ini" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=3;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="750" y="80" width="290" height="150" as="geometry" />
        </mxCell>

        <mxCell id="b6" value="6. PENELUSURAN LEKSIKAL&#10;&#10;pembobotan Okapi BM25&#10;atas 2.248 potongan&#10;&#10;potongan 900 karakter, tumpang-tindih 120,&#10;dipotong pada BATAS KALIMAT&#10;&#10;lima potongan teratas · 200,5 ms" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="750" y="270" width="290" height="190" as="geometry" />
        </mxCell>

        <mxCell id="db" value="ChromaDB&#10;2.248 potongan" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1110" y="290" width="170" height="90" as="geometry" />
        </mxCell>

        <mxCell id="b7" value="7. PEMBANGKITAN REKOMENDASI&#10;&#10;gemini-3.5-flash-lite&#10;temperature 0,2 · maks 700 token&#10;&#10;dibumikan pada potongan terambil,&#10;disertai penunjuk dokumen dan halaman&#10;&#10;≈ 8,6 detik" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="750" y="510" width="290" height="190" as="geometry" />
        </mxCell>

        <mxCell id="b8" value="8. VALIDASI DOKTER&#10;&#10;setujui · sesuaikan · tolak&#10;&#10;dicatat sebagai jejak audit;&#10;dokter tetap penentu akhir" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="400" y="540" width="270" height="160" as="geometry" />
        </mxCell>

        <mxCell id="cad" value="Cadangan berlapis (KNF-04): bila indeks leksikal gagal dibangun, sistem mundur ke jalur padat dan MENYATAKAN penurunan itu;&#10;bila model bahasa tak tersedia, keluaran disusun dari templat berbasis potongan yang tetap tertelusur." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;dashed=1;align=left;verticalAlign=middle;spacingLeft=12;fontSize=12;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="60" y="760" width="1220" height="70" as="geometry" />
        </mxCell>

